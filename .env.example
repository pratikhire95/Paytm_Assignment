# Configuration for docker-compose and the Makefile.
#
#   make env      writes a ready-to-use .env with fresh random secrets (it never overwrites an existing one)
#
# or copy this file to .env and fill in the three secrets yourself. .env is git-ignored: never commit it.

# --- secrets (required, no defaults) ------------------------------------------------------------------------
# Admin credential: the only thing that may create shows (POST /shows). At least 16 characters.
ADMIN_TOKEN=
# HMAC key that signs user tokens. At least 32 characters.
TOKEN_SECRET=
# PostgreSQL password for the bundled database container.
POSTGRES_PASSWORD=

# --- optional ------------------------------------------------------------------------------------------------
# POSTGRES_USER=seats
# POSTGRES_DB=seats
# APP_PORT=8080            # host port of the service
# DB_HOST_PORT=55432       # host port (loopback only) of the database, used by `make test-db`
# DB_POOL_SIZE=20          # JDBC connections per instance
# ALLOW_TOKEN_MINT=true    # POST /auth/token; switch off when real identity tokens are issued elsewhere
# PUBLIC_LOGS_ENABLED=true # GET /logs
